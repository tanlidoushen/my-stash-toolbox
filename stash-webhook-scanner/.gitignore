# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境与密钥
.env
.env.*

# 生成代码（由 clouddrive.proto 生成，可重新生成）
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi

# 内置 python-clouddrive-client 的 pb2 是运行必需（镜像不跑 protoc），强制提交
!clouddrive/proto/*_pb2.py
!clouddrive/proto/*_pb2_grpc.py
!clouddrive/proto/*_grpc.py
!clouddrive/proto/clouddrive_pb2.py

# 系统
Thumbs.db
.DS_Store

# 日志
*.log

# 运行时数据与本地依赖（bind mount，不入库）
vendor/
data/
backups/
